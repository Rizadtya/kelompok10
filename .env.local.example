# ===========================================================================
# .env.local.example  —  TEMPLATE for your SECRET local config
# ===========================================================================
#
# HOW TO USE
#   1. Copy this file to `.env.local`  (that real file is gitignored).
#   2. Fill in the real values.
#   3. `.env.local` is read by the local server (npm run server) only.
#
# On VERCEL do NOT upload this file. Add the same keys in:
#   Vercel → Project → Settings → Environment Variables
#
# SECURITY
#   - `.env.local` is in .gitignore and must NEVER be committed.
#   - SERVICE_ROLE_KEY and GEMINI_API_KEY are SECRET — server-side only.
#   - SUPABASE_URL and SUPABASE_ANON_KEY are public; they ALSO go in
#     public/public_config.js for the browser. We duplicate them here so the
#     local server can verify auth tokens.
# ===========================================================================

# ---- AI provider selection -------------------------------------------------
AI_TEXT_PROVIDER=gemini
AI_VISION_PROVIDER=gemini
AI_IMAGE_PROVIDER=mock

# ---- Google Gemini (SECRET) ------------------------------------------------
# Get it at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-3.5-flash

# ---- Supabase: PUBLIC values (also placed in public/public_config.js) ------
# Supabase Dashboard → Project Settings → Data API (or "API")
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- Supabase: SECRET value (NEVER put this in public_config.js) -----------
# Supabase Dashboard → Project Settings → API → "service_role" secret
SUPABASE_SERVICE_ROLE_KEY=

# Local server port (not used on Vercel).
PORT=8787
