# ---------------------------------------------------------------------------
# Automotive AI Visualizer — environment configuration (EXAMPLE / TEMPLATE)
#
# HOW TO USE
#   Local dev : copy this file to `.env` and fill in real values.
#   Vercel    : DO NOT upload .env. Instead add each variable in
#               Vercel → Project → Settings → Environment Variables.
#
# SECURITY
#   - `.env` is gitignored and must NEVER be committed.
#   - Only this `.env.example` (with NO real secrets) is committed.
#   - API keys are read ONLY on the server (server/ and api/). They are never
#     bundled into the browser and never exposed to the client.
# ---------------------------------------------------------------------------

# Port the local AI/server layer listens on (Vite proxies /api to this).
# Not used on Vercel (serverless functions handle /api there).
PORT=8787

# ---- AI provider selection -------------------------------------------------
# Which provider backs each capability.
# Supported: "mock" (default, no key needed), "gemini", "openai"
#
# Recommended for Gemini (text + vision). Gemini has no image generation on this
# REST surface, so keep AI_IMAGE_PROVIDER=mock (the app shows an honest
# configuration-based concept instead of a fake render).
AI_TEXT_PROVIDER=gemini
AI_VISION_PROVIDER=gemini
AI_IMAGE_PROVIDER=mock

# ---- Google Gemini ---------------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
# Optional override; leave as-is unless you have a reason to change it.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---- OpenAI (optional alternative) -----------------------------------------
# Only needed if any provider above is set to "openai".
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# ---- Generic OpenAI-compatible provider (optional) -------------------------
AI_BASE_URL=
AI_API_KEY=
