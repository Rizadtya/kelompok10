# ---------------------------------------------------------------------------
# Automotive AI Visualizer — environment configuration (example)
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# All AI credentials are read ONLY on the server (server/index.js).
# ---------------------------------------------------------------------------

# Port the local AI/server layer listens on (Vite proxies /api to this).
PORT=8787

# ---- AI provider selection -------------------------------------------------
# Which provider implementation to use for each capability.
# Supported values: "mock" (default, no credentials needed), "openai"
AI_TEXT_PROVIDER=mock
AI_VISION_PROVIDER=mock
AI_IMAGE_PROVIDER=mock

# ---- OpenAI (optional) -----------------------------------------------------
# Only required if any provider above is set to "openai".
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# ---- Generic/compatible provider (optional) --------------------------------
# For any OpenAI-compatible endpoint. Leave blank to ignore.
AI_BASE_URL=
AI_API_KEY=
