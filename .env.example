# ---------------------------------------------------------------------------
# Automotive AI Visualizer — environment configuration (EXAMPLE / TEMPLATE)
#
# HOW TO USE
#   Local dev : copy this file to `.env` and fill in real values.
#               (`.env` is gitignored and must NEVER be committed.)
#   Vercel    : DO NOT upload any .env file. Add each variable in
#               Vercel → Project → Settings → Environment Variables.
#
# SECURITY
#   - Only this template is committed. Keep every secret value blank here.
#   - API keys are read ONLY on the server (server/ and api/). They are never
#     bundled into the browser and never exposed to the client.
#   - SUPABASE_URL and SUPABASE_ANON_KEY are public; they ALSO go in
#     public/public_config.js for the browser.
#   - SUPABASE_SERVICE_ROLE_KEY is SECRET. It must NEVER go in public_config.js.
# ===========================================================================

# Port the local AI/server layer listens on (Vite proxies /api to this).
# Not used on Vercel (serverless functions handle /api there).
PORT=8787

# ---- AI provider selection -------------------------------------------------
# Which provider backs each capability.
# Supported: "mock" (no key needed), "gemini", "openai"
AI_TEXT_PROVIDER=gemini
AI_VISION_PROVIDER=gemini
# Gemini has no image generation on this REST surface, so keep this on "mock".
# The app then shows an honest configuration-based concept, not a fake render.
AI_IMAGE_PROVIDER=mock

# ---- Google Gemini (SECRET) ------------------------------------------------
# Get keys at https://aistudio.google.com/apikey
# One or more keys, comma- or newline-separated. A single key is fine.
# If a key fails (invalid, quota exhausted, rate-limited), the server tries
# the next key. Starting key rotates round-robin across requests.
# Example format: GEMINI_API_KEY_POOL=key_one,key_two,key_three
GEMINI_API_KEY_POOL=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-3.5-flash
# Optional override; leave commented unless you have a reason to change it.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---- OpenAI (SECRET, optional) ---------------------------------------------
# Only needed if a provider above is set to "openai".
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# ---- Generic OpenAI-compatible provider (optional) -------------------------
# Leave commented unless a server file actually reads these.
# AI_BASE_URL=
# AI_API_KEY=

# ---- Supabase: PUBLIC values (also placed in public/public_config.js) ------
# Supabase Dashboard → Project Settings → Data API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- Supabase: SECRET value (server only) ----------------------------------
# Supabase Dashboard → Project Settings → API → "service_role" secret
SUPABASE_SERVICE_ROLE_KEY=
